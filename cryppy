<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimalist Chess</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <style>
        :root {
            --bg: #0d1117;
            --card: #161b22;
            --light-sq: #ebecd0;
            --dark-sq: #739552;
            --highlight: rgba(255, 255, 51, 0.5);
            --text: #c9d1d9;
            --accent: #238636;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body {
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: var(--card);
            padding: 24px;
            border-radius: 12px;
            border: 1px solid #30363d;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            text-align: center;
        }
        h1 { font-size: 1.5rem; margin-bottom: 8px; color: #fff; }
        #status { margin-bottom: 16px; font-size: 0.95rem; color: #8b949e; min-height: 22px; }
        .board {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            width: min(85vw, 440px);
            height: min(85vw, 440px);
            border: 3px solid #30363d;
            border-radius: 6px;
            overflow: hidden;
            user-select: none;
        }
        .square {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(24px, 6vw, 40px);
            cursor: pointer;
            position: relative;
        }
        .light { background-color: var(--light-sq); color: #000; }
        .dark { background-color: var(--dark-sq); color: #000; }
        .selected { background-color: #f6f669 !important; }
        .possible::after {
            content: "";
            width: 28%;
            height: 28%;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 50%;
            position: absolute;
        }
        .controls {
            margin-top: 18px;
            display: flex;
            gap: 10px;
            justify-content: center;
        }
        button {
            background: #21262d;
            color: #c9d1d9;
            border: 1px solid #30363d;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: 0.2s;
        }
        button:hover { background: #30363d; }
        button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
        button.primary:hover { background: #2ea043; }
    </style>
</head>
<body>

<div class="container">
    <h1>♟️ Shaxmat</h1>
    <div id="status">Oqlar yurishi</div>
    <div class="board" id="board"></div>
    <div class="controls">
        <button class="primary" onclick="resetGame()">Yangi o'yin</button>
        <button onclick="undoMove()">Orqaga</button>
        <button id="modeBtn" onclick="toggleMode()">Rejim: Botga qarshi</button>
    </div>
</div>

<script>
    const game = new Chess();
    const boardEl = document.getElementById('board');
    const statusEl = document.getElementById('status');
    let selectedSquare = null;
    let vsBot = true;

    const pieces = {
        'p': '♟', 'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚',
        'P': '♙', 'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔'
    };

    function renderBoard() {
        boardEl.innerHTML = '';
        const board = game.board();
        const possibleMoves = selectedSquare ? game.moves({ square: selectedSquare, verbose: true }).map(m => m.to) : [];

        for (let r = 0; r < 8; r++) {
            for (let c = 0; c < 8; c++) {
                const sqName = String.fromCharCode(97 + c) + (8 - r);
                const sqEl = document.createElement('div');
                sqEl.className = `square ${(r + c) % 2 === 0 ? 'light' : 'dark'}`;
                if (selectedSquare === sqName) sqEl.classList.add('selected');
                if (possibleMoves.includes(sqName)) sqEl.classList.add('possible');

                const piece = board[r][c];
                if (piece) {
                    const symbol = piece.color === 'w' ? pieces[piece.type.toUpperCase()] : pieces[piece.type];
                    sqEl.textContent = symbol;
                    sqEl.style.color = piece.color === 'w' ? '#ffffff' : '#111111';
                    sqEl.style.textShadow = piece.color === 'w' ? '0 1px 3px rgba(0,0,0,0.8)' : 'none';
                }

                sqEl.onclick = () => onSquareClick(sqName);
                boardEl.appendChild(sqEl);
            }
        }
        updateStatus();
    }

    function onSquareClick(sq) {
        if (game.game_over()) return;
        if (vsBot && game.turn() === 'b') return;

        if (selectedSquare) {
            const move = game.move({ from: selectedSquare, to: sq, promotion: 'q' });
            selectedSquare = null;
            renderBoard();
            if (move && vsBot && !game.game_over()) {
                setTimeout(makeBotMove, 300);
            }
        } else {
            const piece = game.get(sq);
            if (piece && piece.color === game.turn()) {
                selectedSquare = sq;
                renderBoard();
            }
        }
    }

    function makeBotMove() {
        const moves = game.moves({ verbose: true });
        if (moves.length === 0) return;
        // Oddiy ustuvorlik: urib olish yurishlarini afzal ko'radi
        const captures = moves.filter(m => m.captured);
        const chosen = captures.length > 0
            ? captures[Math.floor(Math.random() * captures.length)]
            : moves[Math.floor(Math.random() * moves.length)];
        game.move(chosen);
        renderBoard();
    }

    function updateStatus() {
        let status = '';
        const turn = game.turn() === 'w' ? 'Oqlar' : 'Qoralar';
        if (game.in_checkmate()) {
            status = `Mot! ${turn} yutqazdi.`;
        } else if (game.in_draw()) {
            status = 'Durang!';
        } else {
            status = `${turn} yurishi` + (game.in_check() ? ' (Shoh!)' : '');
        }
        statusEl.textContent = status;
    }

    function resetGame() {
        game.reset();
        selectedSquare = null;
        renderBoard();
    }

    function undoMove() {
        game.undo();
        if (vsBot) game.undo();
        selectedSquare = null;
        renderBoard();
    }

    function toggleMode() {
        vsBot = !vsBot;
        document.getElementById('modeBtn').textContent = vsBot ? 'Rejim: Botga qarshi' : 'Rejim: 2 o\'yinchi';
        resetGame();
    }

    renderBoard();
</script>
</body>
</html>
